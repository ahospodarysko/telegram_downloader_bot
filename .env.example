# Copy this file to .env and fill in your bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user id — required to use the /stats command.
# Get it from @userinfobot.
ADMIN_TELEGRAM_ID=

# Optional: where the users db (sqlite) is stored. Defaults to ./data/users.db
# On Railway, point this at a mounted volume's path (e.g. /data/users.db)
# so the user list survives redeploys.
USERS_DB_PATH=
